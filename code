; ============================================================
; Student Information System (SIS) - Assembly Language
; Dr. A. Q. Khan Institute (KICSIT)
; Computer Organization and Assembly Language Lab
; ============================================================
; Assemble: nasm -f bin student_info_system.asm -o sis.com
; Run:      dosbox sis.com
; ============================================================
; RECORD LAYOUT (80 bytes each, MAX 50 students):
;   Offset  0 : ID        (5  bytes)
;   Offset  5 : Name      (21 bytes)
;   Offset 26 : Age       (2  bytes, word)
;   Offset 28 : Class     (6  bytes)
;   Offset 34 : TotalFee  (2  bytes, word)
;   Offset 36 : FeePaid   (2  bytes, word)
;   Offset 38 : Status    (1  byte )
;   Offset 39 : AttDays   (1  byte )
;   Offset 40 : TotalDays (1  byte )
;   Offset 41 : Sub1      (1  byte )
;   Offset 42 : Sub2      (1  byte )
;   Offset 43 : Sub3      (1  byte )
;   Offset 44 : Sub4      (1  byte )
;   Offset 45 : Fitness   (1  byte )
;   Offset 46 : Disability(1  byte )
;   Offset 47 : DisDesc   (20 bytes)
;   Offset 67 : Reserved  (13 bytes)
; ============================================================

    org  100h
    bits 16

    jmp  start          ; skip over data

; ============================================================
; DATA
; ============================================================
welcome_msg     db 0Dh,0Ah,'========================================',0Dh,0Ah
                db '   STUDENT INFORMATION SYSTEM (SIS)',0Dh,0Ah
                db '   KICSIT - Assembly Language Lab',0Dh,0Ah
                db '========================================',0Dh,0Ah
                db 0Dh,0Ah,'Press any key to continue...',0Dh,0Ah,'$'

main_menu       db 0Dh,0Ah,'========== MAIN MENU ==========',0Dh,0Ah
                db '1. Admission Management',0Dh,0Ah
                db '2. Current Status of Students',0Dh,0Ah
                db '3. Fee Management Record',0Dh,0Ah
                db '4. Attendance Management',0Dh,0Ah
                db '5. Students Results & Performance',0Dh,0Ah
                db '6. Health Fitness & Disability Record',0Dh,0Ah
                db '7. View All Students',0Dh,0Ah
                db '8. Exit',0Dh,0Ah
                db '================================',0Dh,0Ah
                db 'Enter your choice (1-8): ','$'

invalid_choice  db 0Dh,0Ah,'Invalid choice! Please try again.',0Dh,0Ah,'$'
return_menu     db 0Dh,0Ah,'Press any key to return to main menu...',0Dh,0Ah,'$'
newline         db 0Dh,0Ah,'$'

adm_header      db 0Dh,0Ah,'======== ADMISSION MANAGEMENT ========',0Dh,0Ah,'$'
adm_prompt_id   db 0Dh,0Ah,'Enter Student ID (max 4 digits): ','$'
adm_prompt_name db 'Enter Student Name (max 20 chars): ','$'
adm_prompt_age  db 'Enter Student Age: ','$'
adm_prompt_cls  db 'Enter Class/Section (e.g. BS-1): ','$'
adm_prompt_fee  db 'Enter Total Fee Amount: ','$'
adm_prompt_paid db 'Enter Fee Paid: ','$'
adm_success     db 0Dh,0Ah,'[SUCCESS] Student admitted successfully!',0Dh,0Ah,'$'
adm_full        db 0Dh,0Ah,'[ERROR] Student database is full!',0Dh,0Ah,'$'
adm_dup_id      db 0Dh,0Ah,'[ERROR] Student ID already exists!',0Dh,0Ah,'$'

status_header   db 0Dh,0Ah,'======== STUDENT STATUS ========',0Dh,0Ah,'$'
status_prompt   db 0Dh,0Ah,'Enter Student ID to update status: ','$'
status_menu     db 0Dh,0Ah,'Select Status:',0Dh,0Ah
                db '1. In-Studies',0Dh,0Ah
                db '2. Left',0Dh,0Ah
                db '3. Pass Out',0Dh,0Ah
                db '4. Suspended',0Dh,0Ah
                db 'Enter choice (1-4): ','$'
status_success  db 0Dh,0Ah,'[SUCCESS] Status updated!',0Dh,0Ah,'$'
status_notfound db 0Dh,0Ah,'[ERROR] Student not found!',0Dh,0Ah,'$'
status_labels   db 'In-Studies  '
                db 'Left        '
                db 'Pass Out    '
                db 'Suspended   '

fee_header      db 0Dh,0Ah,'======== FEE MANAGEMENT ========',0Dh,0Ah,'$'
fee_prompt_id   db 0Dh,0Ah,'Enter Student ID: ','$'
fee_prompt_amt  db 'Enter Fee Amount to Pay: ','$'
fee_success     db 0Dh,0Ah,'[SUCCESS] Fee updated!',0Dh,0Ah,'$'
fee_notfound    db 0Dh,0Ah,'[ERROR] Student not found!',0Dh,0Ah,'$'
fee_display     db 0Dh,0Ah,'Total Fee: ','$'
fee_paid_lbl    db ' | Paid: ','$'
fee_due_lbl     db ' | Due: ','$'

att_header      db 0Dh,0Ah,'======== ATTENDANCE MANAGEMENT ========',0Dh,0Ah,'$'
att_prompt_id   db 0Dh,0Ah,'Enter Student ID: ','$'
att_prompt_days db 'Enter Days Present (this month): ','$'
att_prompt_total db 'Enter Total Working Days: ','$'
att_success     db 0Dh,0Ah,'[SUCCESS] Attendance recorded!',0Dh,0Ah,'$'
att_notfound    db 0Dh,0Ah,'[ERROR] Student not found!',0Dh,0Ah,'$'
att_percent_lbl db ' | Attendance: ','$'
pct_sign        db '%',0Dh,0Ah,'$'

res_header      db 0Dh,0Ah,'======== RESULTS & PERFORMANCE ========',0Dh,0Ah,'$'
res_prompt_id   db 0Dh,0Ah,'Enter Student ID: ','$'
res_prompt_sub1 db 'Enter marks Subject 1 (0-100): ','$'
res_prompt_sub2 db 'Enter marks Subject 2 (0-100): ','$'
res_prompt_sub3 db 'Enter marks Subject 3 (0-100): ','$'
res_prompt_sub4 db 'Enter marks Subject 4 (0-100): ','$'
res_success     db 0Dh,0Ah,'[SUCCESS] Results recorded!',0Dh,0Ah,'$'
res_notfound    db 0Dh,0Ah,'[ERROR] Student not found!',0Dh,0Ah,'$'
res_total_lbl   db 0Dh,0Ah,'Total: ','$'
res_avg_lbl     db ' | Avg: ','$'
res_grade_lbl   db ' | Grade: ','$'
res_gpa_lbl     db ' | GPA: ','$'

health_header   db 0Dh,0Ah,'======== HEALTH & DISABILITY ========',0Dh,0Ah,'$'
health_prompt_id  db 0Dh,0Ah,'Enter Student ID: ','$'
health_prompt_fit db 'Fitness Level (1-5): ','$'
health_prompt_dis db 'Disability? (0=No, 1=Yes): ','$'
health_prompt_desc db 'Describe disability (max 19): ','$'
health_success  db 0Dh,0Ah,'[SUCCESS] Health record updated!',0Dh,0Ah,'$'
health_notfound db 0Dh,0Ah,'[ERROR] Student not found!',0Dh,0Ah,'$'
health_fit_lbl  db ' | Fitness: ','$'
health_dis_lbl  db ' | Disability: ','$'

view_header     db 0Dh,0Ah,'======== ALL STUDENT RECORDS ========',0Dh,0Ah,'$'
view_empty      db 0Dh,0Ah,'[INFO] No students in database.',0Dh,0Ah,'$'
view_id_lbl     db 0Dh,0Ah,'ID: ','$'
view_name_lbl   db ' | Name: ','$'
view_cls_lbl    db ' | Class: ','$'
view_age_lbl    db ' | Age: ','$'
view_status_lbl db ' | Status: ','$'
view_sep        db '----------------------------------------',0Dh,0Ah,'$'
yes_str         db 'Yes','$'
no_str          db 'No','$'

; input buffer (DOS 0Ah buffered input)
input_buffer    db 25, 0
                times 25 db 0
; 6-char scratch for print_number  (5 digits + '$')
temp_str        db '     ','$'

MAX_STUDENTS    equ 50
RECORD_SIZE     equ 80

student_count   db 0
student_records times MAX_STUDENTS * RECORD_SIZE db 0

; ============================================================
; CODE
; ============================================================
start:
    mov  dx, welcome_msg
    call print_string
    call wait_key

; ------------------------------------------------------------------
main_loop:
    ; clear screen
    mov  ax, 0600h
    mov  bh, 07h
    xor  cx, cx
    mov  dx, 184Fh
    int  10h
    ; home cursor
    mov  ah, 02h
    xor  bh, bh
    xor  dx, dx
    int  10h

    mov  dx, main_menu
    call print_string
    call get_menu_digit         ; AL = '1'..'8'

    cmp  al, '8'
    jne  ml_not8
    jmp  exit_program
ml_not8:
    cmp  al, '1'
    jb   ml_invalid
    cmp  al, '7'
    ja   ml_invalid

    sub  al, '1'
    xor  ah, ah
    shl  ax, 1
    mov  si, ax
    jmp  [menu_jumps + si]

ml_invalid:
    mov  dx, invalid_choice
    call print_string
    call wait_key
    jmp  main_loop

menu_jumps  dw admission_module
            dw status_module
            dw fee_module
            dw attendance_module
            dw results_module
            dw health_module
            dw view_all_module

; ============================================================
; MODULE 1: ADMISSION
; ============================================================
admission_module:
    mov  dx, adm_header
    call print_string

    mov  al, [student_count]
    cmp  al, MAX_STUDENTS
    jb   adm_not_full
    jmp  adm_full_error
adm_not_full:

    ; DI -> new record
    xor  ah, ah
    mov  bx, RECORD_SIZE
    mul  bx
    mov  di, student_records
    add  di, ax

    ; ID
    mov  dx, adm_prompt_id
    call print_string
    call read_string
    call check_duplicate_id
    jnc  adm_no_dup
    jmp  adm_dup_error
adm_no_dup:
    push di
    mov  si, input_buffer + 2
    mov  cx, 5
    call copy_field
    pop  di

    ; Name
    mov  dx, adm_prompt_name
    call print_string
    call read_string
    push di
    add  di, 5
    mov  si, input_buffer + 2
    mov  cx, 21
    call copy_field
    pop  di

    ; Age
    mov  dx, adm_prompt_age
    call print_string
    call read_number
    mov  [di + 26], ax

    ; Class
    mov  dx, adm_prompt_cls
    call print_string
    call read_string
    push di
    add  di, 28
    mov  si, input_buffer + 2
    mov  cx, 6
    call copy_field
    pop  di

    ; Total Fee
    mov  dx, adm_prompt_fee
    call print_string
    call read_number
    mov  [di + 34], ax

    ; Fee Paid
    mov  dx, adm_prompt_paid
    call print_string
    call read_number
    mov  [di + 36], ax

    ; Defaults
    mov  byte [di + 38], 1      ; Status = In-Studies
    mov  byte [di + 39], 0
    mov  byte [di + 40], 0
    mov  byte [di + 41], 0
    mov  byte [di + 42], 0
    mov  byte [di + 43], 0
    mov  byte [di + 44], 0
    mov  byte [di + 45], 0
    mov  byte [di + 46], 0

    inc  byte [student_count]
    mov  dx, adm_success
    call print_string
    jmp  return_to_main

adm_full_error:
    mov  dx, adm_full
    call print_string
    jmp  return_to_main

adm_dup_error:
    mov  dx, adm_dup_id
    call print_string
    jmp  return_to_main

; ============================================================
; MODULE 2: STATUS
; ============================================================
status_module:
    mov  dx, status_header
    call print_string
    mov  dx, status_prompt
    call print_string
    call read_string

    call find_student_by_id
    jnc  stat_found
    jmp  stat_notfound
stat_found:
    mov  dx, status_menu
    call print_string
    call get_14_digit           ; AL = '1'..'4'
    sub  al, '0'                ; 1..4
    cmp  al, 4
    jbe  stat_ok
    jmp  stat_invalid
stat_ok:
    mov  [di + 38], al
    mov  dx, status_success
    call print_string
    jmp  return_to_main

stat_invalid:
    mov  dx, invalid_choice
    call print_string
    jmp  return_to_main

stat_notfound:
    mov  dx, status_notfound
    call print_string
    jmp  return_to_main

; ============================================================
; MODULE 3: FEE
; ============================================================
fee_module:
    mov  dx, fee_header
    call print_string
    mov  dx, fee_prompt_id
    call print_string
    call read_string

    call find_student_by_id
    jnc  fee_found
    jmp  fee_notfound_lbl
fee_found:
    mov  dx, fee_display
    call print_string
    mov  ax, [di + 34]
    call print_number

    mov  dx, fee_paid_lbl
    call print_string
    mov  ax, [di + 36]
    call print_number

    mov  dx, fee_due_lbl
    call print_string
    mov  ax, [di + 34]
    sub  ax, [di + 36]
    call print_number

    mov  dx, newline
    call print_string

    mov  dx, fee_prompt_amt
    call print_string
    call read_number
    add  [di + 36], ax

    mov  dx, fee_success
    call print_string
    jmp  return_to_main

fee_notfound_lbl:
    mov  dx, fee_notfound
    call print_string
    jmp  return_to_main

; ============================================================
; MODULE 4: ATTENDANCE
; ============================================================
attendance_module:
    mov  dx, att_header
    call print_string
    mov  dx, att_prompt_id
    call print_string
    call read_string

    call find_student_by_id
    jnc  att_found
    jmp  att_notfound_lbl
att_found:
    mov  dx, att_prompt_days
    call print_string
    call read_number
    mov  [di + 39], al

    mov  dx, att_prompt_total
    call print_string
    call read_number
    mov  [di + 40], al

    ; show percentage
    mov  dx, att_percent_lbl
    call print_string
    mov  al, [di + 40]
    cmp  al, 0
    je   att_zero_total
    xor  ah, ah
    mov  bx, ax                 ; BX = total days
    xor  ah, ah
    mov  al, [di + 39]          ; present days
    xor  ah, ah
    mov  cx, 100
    mul  cx                     ; DX:AX = present*100
    div  bx                     ; AX = percentage
    call print_number
    jmp  att_pct_done
att_zero_total:
    xor  ax, ax
    call print_number
att_pct_done:
    mov  dx, pct_sign
    call print_string
    mov  dx, att_success
    call print_string
    jmp  return_to_main

att_notfound_lbl:
    mov  dx, att_notfound
    call print_string
    jmp  return_to_main

; ============================================================
; MODULE 5: RESULTS
; ============================================================
results_module:
    mov  dx, res_header
    call print_string
    mov  dx, res_prompt_id
    call print_string
    call read_string

    call find_student_by_id
    jnc  res_found
    jmp  res_notfound_lbl
res_found:
    mov  dx, res_prompt_sub1
    call print_string
    call read_number
    mov  [di + 41], al

    mov  dx, res_prompt_sub2
    call print_string
    call read_number
    mov  [di + 42], al

    mov  dx, res_prompt_sub3
    call print_string
    call read_number
    mov  [di + 43], al

    mov  dx, res_prompt_sub4
    call print_string
    call read_number
    mov  [di + 44], al

    ; total
    xor  ax, ax
    xor  bh, bh
    mov  bl, [di + 41]
    add  ax, bx
    mov  bl, [di + 42]
    add  ax, bx
    mov  bl, [di + 43]
    add  ax, bx
    mov  bl, [di + 44]
    add  ax, bx             ; AX = total (0..400)

    mov  dx, res_total_lbl
    call print_string
    push ax
    call print_number
    pop  ax

    ; average
    xor  dx, dx
    mov  bx, 4
    div  bx                 ; AX = average
    push ax

    mov  dx, res_avg_lbl
    call print_string
    call print_number

    ; GPA = avg / 20
    pop  ax
    push ax
    xor  dx, dx
    mov  bx, 20
    div  bx
    mov  dx, res_gpa_lbl
    call print_string
    call print_number

    ; grade
    pop  ax                 ; average
    mov  dx, res_grade_lbl
    call print_string
    cmp  al, 90
    jge  grd_a
    cmp  al, 80
    jge  grd_b
    cmp  al, 70
    jge  grd_c
    cmp  al, 60
    jge  grd_d
    mov  dl, 'F'
    jmp  grd_print
grd_a: mov dl, 'A'
    jmp  grd_print
grd_b: mov dl, 'B'
    jmp  grd_print
grd_c: mov dl, 'C'
    jmp  grd_print
grd_d: mov dl, 'D'
grd_print:
    mov  ah, 02h
    int  21h
    mov  dx, newline
    call print_string
    mov  dx, res_success
    call print_string
    jmp  return_to_main

res_notfound_lbl:
    mov  dx, res_notfound
    call print_string
    jmp  return_to_main

; ============================================================
; MODULE 6: HEALTH
; ============================================================
health_module:
    mov  dx, health_header
    call print_string
    mov  dx, health_prompt_id
    call print_string
    call read_string

    call find_student_by_id
    jnc  hlth_found
    jmp  hlth_notfound_lbl
hlth_found:
    mov  dx, health_prompt_fit
    call print_string
    call read_number
    mov  [di + 45], al

    mov  dx, health_prompt_dis
    call print_string
    call read_number
    mov  [di + 46], al

    cmp  al, 1
    jne  hlth_save
    mov  dx, health_prompt_desc
    call print_string
    call read_string
    push di
    add  di, 47
    mov  si, input_buffer + 2
    mov  cx, 20
    call copy_field
    pop  di

hlth_save:
    mov  dx, health_success
    call print_string
    jmp  return_to_main

hlth_notfound_lbl:
    mov  dx, health_notfound
    call print_string
    jmp  return_to_main

; ============================================================
; MODULE 7: VIEW ALL
; ============================================================
view_all_module:
    mov  dx, view_header
    call print_string

    mov  al, [student_count]
    cmp  al, 0
    jne  view_has_data
    jmp  view_empty_lbl
view_has_data:
    xor  ch, ch
    mov  cl, al
    mov  si, student_records

view_loop:
    push cx
    mov  di, si

    mov  dx, view_sep
    call print_string

    ; ID
    mov  dx, view_id_lbl
    call print_string
    mov  dx, di
    call print_field5

    ; Name
    mov  dx, view_name_lbl
    call print_string
    lea  dx, [di + 5]
    call print_field21

    ; Age
    mov  dx, view_age_lbl
    call print_string
    mov  ax, [di + 26]
    call print_number

    ; Class
    mov  dx, view_cls_lbl
    call print_string
    lea  dx, [di + 28]
    call print_field6

    ; Status
    mov  dx, view_status_lbl
    call print_string
    mov  al, [di + 38]
    call print_status_label

    ; Fee
    mov  dx, fee_display
    call print_string
    mov  ax, [di + 34]
    call print_number
    mov  dx, fee_paid_lbl
    call print_string
    mov  ax, [di + 36]
    call print_number
    mov  dx, fee_due_lbl
    call print_string
    mov  ax, [di + 34]
    sub  ax, [di + 36]
    call print_number

    ; Attendance %
    mov  dx, att_percent_lbl
    call print_string
    mov  al, [di + 40]
    cmp  al, 0
    je   view_att_zero
    xor  ah, ah
    mov  bx, ax
    xor  ah, ah
    mov  al, [di + 39]
    xor  ah, ah
    mov  cx, 100
    mul  cx
    div  bx
    call print_number
    jmp  view_att_done
view_att_zero:
    xor  ax, ax
    call print_number
view_att_done:
    mov  dx, pct_sign
    call print_string

    ; Fitness
    mov  dx, health_fit_lbl
    call print_string
    xor  ah, ah
    mov  al, [di + 45]
    call print_number

    ; Disability
    mov  dx, health_dis_lbl
    call print_string
    cmp  byte [di + 46], 1
    jne  view_no_dis
    mov  dx, yes_str
    call print_string
    jmp  view_dis_done
view_no_dis:
    mov  dx, no_str
    call print_string
view_dis_done:
    mov  dx, newline
    call print_string

    pop  cx
    add  si, RECORD_SIZE

    ; use near jump via dec/jnz for long loop
    dec  cx
    jnz  view_loop_near
    jmp  return_to_main
view_loop_near:
    push cx
    jmp  view_loop

view_empty_lbl:
    mov  dx, view_empty
    call print_string
    jmp  return_to_main

; ============================================================
; EXIT & RETURN
; ============================================================
exit_program:
    mov  ax, 4C00h
    int  21h

return_to_main:
    mov  dx, return_menu
    call print_string
    call wait_key
    jmp  main_loop

; ============================================================
; HELPER ROUTINES
; ============================================================

; print '$'-terminated string, DX = address
print_string:
    push ax
    mov  ah, 09h
    int  21h
    pop  ax
    ret

; print up to 5 printable bytes starting at [DX]
print_field5:
    push cx
    push si
    mov  si, dx
    mov  cx, 5
    call pf_inner
    pop  si
    pop  cx
    ret

; print up to 21 printable bytes starting at [DX]
print_field21:
    push cx
    push si
    mov  si, dx
    mov  cx, 21
    call pf_inner
    pop  si
    pop  cx
    ret

; print up to 6 printable bytes starting at [DX]
print_field6:
    push cx
    push si
    mov  si, dx
    mov  cx, 6
    call pf_inner
    pop  si
    pop  cx
    ret

; shared inner loop for print_fieldN  (SI=ptr, CX=count)
pf_inner:
    push ax
    push dx
pf_lp:
    jcxz pf_done
    lodsb
    cmp  al, 0
    je   pf_done
    cmp  al, '$'
    je   pf_done
    cmp  al, ' '
    je   pf_skip
    mov  dl, al
    mov  ah, 02h
    int  21h
pf_skip:
    dec  cx
    jmp  pf_lp
pf_done:
    pop  dx
    pop  ax
    ret

; print AX as unsigned decimal (no leading zeros)
print_number:
    push ax
    push bx
    push cx
    push dx
    push si

    ; build digits into temp_str (5 chars + '$')
    mov  si, temp_str
    add  si, 4          ; point to last digit slot
    mov  byte [si+1], '$'
    mov  cx, 5
    mov  bx, 10
pn_cvt:
    xor  dx, dx
    div  bx
    add  dl, '0'
    mov  [si], dl
    dec  si
    loop pn_cvt

    inc  si             ; SI -> first digit slot
    ; skip leading zeros, but keep at least 1 digit
pn_skip:
    cmp  byte [si], '0'
    jne  pn_print
    cmp  byte [si+1], '$'
    je   pn_print
    inc  si
    jmp  pn_skip
pn_print:
    mov  dx, si
    mov  ah, 09h
    int  21h

    pop  si
    pop  dx
    pop  cx
    pop  bx
    pop  ax
    ret

; print status label for AL (1..4)
print_status_label:
    push ax
    push bx
    push cx
    push si

    cmp  al, 1
    jb   psl_unknown
    cmp  al, 4
    ja   psl_unknown
    dec  al
    xor  ah, ah
    mov  bl, 12
    mul  bl
    mov  si, status_labels
    add  si, ax
    mov  cx, 12
psl_lp:
    lodsb
    cmp  al, ' '
    je   psl_nxt
    mov  dl, al
    mov  ah, 02h
    int  21h
psl_nxt:
    loop psl_lp
    jmp  psl_done
psl_unknown:
    mov  dx, newline
    call print_string
psl_done:
    pop  si
    pop  cx
    pop  bx
    pop  ax
    ret

; read buffered string into input_buffer
read_string:
    push ax
    push dx
    push si
    mov  byte [input_buffer],   23
    mov  byte [input_buffer+1],  0
    mov  dx, input_buffer
    mov  ah, 0Ah
    int  21h
    ; null + '$' terminate
    xor  ah, ah
    mov  al, [input_buffer+1]
    mov  si, input_buffer + 2
    add  si, ax
    mov  byte [si],   0
    mov  byte [si+1], '$'
    pop  si
    pop  dx
    pop  ax
    ret

; read decimal number, return in AX
read_number:
    push bx
    push cx
    push si
    call read_string
    mov  si, input_buffer + 2
    xor  ax, ax
    xor  ch, ch
    mov  cl, [input_buffer+1]
    jcxz rn_done
rn_lp:
    xor  bh, bh
    mov  bl, [si]
    inc  si
    sub  bl, '0'
    cmp  bl, 9
    ja   rn_done
    push bx
    mov  bx, 10
    mul  bx
    pop  bx
    add  ax, bx
    loop rn_lp
rn_done:
    pop  si
    pop  cx
    pop  bx
    ret

; wait for key '1'..'8', echo it, return in AL
; FIXED: Uses BIOS int 16h instead of DOS int 21h/01h to avoid double echo
get_menu_digit:
    push bx
    push cx
    push dx
gmd_lp:
    mov  ah, 00h          ; BIOS keyboard read (blocking, NO echo)
    int  16h
    cmp  al, '1'
    jb   gmd_lp
    cmp  al, '8'
    ja   gmd_lp
    mov  dl, al
    mov  ah, 02h          ; Print character once via DOS
    int  21h
    pop  dx
    pop  cx
    pop  bx
    ret

; wait for key '1'..'4', echo it, return in AL
; FIXED: Uses BIOS int 16h instead of DOS int 21h/01h to avoid double echo
get_14_digit:
    push bx
    push cx
    push dx
g14_lp:
    mov  ah, 00h          ; BIOS keyboard read (blocking, NO echo)
    int  16h
    cmp  al, '1'
    jb   g14_lp
    cmp  al, '4'
    ja   g14_lp
    mov  dl, al
    mov  ah, 02h          ; Print character once via DOS
    int  21h
    pop  dx
    pop  cx
    pop  bx
    ret

; wait for any key (BIOS)
wait_key:
    push ax
    mov  ah, 00h
    int  16h
    pop  ax
    ret

; copy up to CX bytes from [SI] to [DI], space-pad remainder
; DI is NOT preserved (caller push/pop as needed)
copy_field:
    push ax
cf_copy:
    jcxz cf_done
    lodsb
    cmp  al, 0Dh
    je   cf_pad
    cmp  al, 0
    je   cf_pad
    cmp  al, '$'
    je   cf_pad
    stosb
    dec  cx
    jmp  cf_copy
cf_pad:
    mov  al, ' '
    rep  stosb
cf_done:
    pop  ax
    ret

; find student by ID in input_buffer+2
; returns CF=0 + DI=record base if found, CF=1 if not found
find_student_by_id:
    push ax
    push bx
    push cx
    push si

    mov  al, [student_count]
    cmp  al, 0
    je   fsid_not_found
    xor  ah, ah
    mov  bx, ax
    mov  di, student_records

fsid_loop:
    push di
    mov  si, input_buffer + 2
    mov  cx, 4
fsid_cmp:
    mov  al, [si]
    cmp  al, 0
    je   fsid_end_inp
    cmp  al, '$'
    je   fsid_end_inp
    cmp  al, [di]
    jne  fsid_no_match
    inc  si
    inc  di
    loop fsid_cmp
    ; check record terminator
    mov  al, [di]
    cmp  al, ' '
    je   fsid_found_pop
    cmp  al, 0
    je   fsid_found_pop
    jmp  fsid_no_match
fsid_end_inp:
    mov  al, [di]
    cmp  al, ' '
    je   fsid_found_pop
    cmp  al, 0
    je   fsid_found_pop
fsid_no_match:
    pop  di
    add  di, RECORD_SIZE
    dec  bx
    jnz  fsid_loop

fsid_not_found:
    pop  si
    pop  cx
    pop  bx
    pop  ax
    stc
    ret

fsid_found_pop:
    pop  di                 ; restore record base
    pop  si
    pop  cx
    pop  bx
    pop  ax
    clc
    ret

; check duplicate ID; CF=1 if duplicate exists
check_duplicate_id:
    push ax
    push bx
    push cx
    push si
    push di

    mov  al, [student_count]
    cmp  al, 0
    je   cdup_no
    xor  ah, ah
    mov  bx, ax
    mov  di, student_records

cdup_loop:
    push di
    mov  si, input_buffer + 2
    mov  cx, 4
cdup_cmp:
    mov  al, [si]
    cmp  al, 0
    je   cdup_end_inp
    cmp  al, '$'
    je   cdup_end_inp
    cmp  al, [di]
    jne  cdup_no_match
    inc  si
    inc  di
    loop cdup_cmp
    mov  al, [di]
    cmp  al, ' '
    je   cdup_found
    cmp  al, 0
    je   cdup_found
    jmp  cdup_no_match
cdup_end_inp:
    mov  al, [di]
    cmp  al, ' '
    je   cdup_found
    cmp  al, 0
    je   cdup_found
cdup_no_match:
    pop  di
    add  di, RECORD_SIZE
    dec  bx
    jnz  cdup_loop

cdup_no:
    pop  di
    pop  si
    pop  cx
    pop  bx
    pop  ax
    clc
    ret

cdup_found:
    pop  di                 ; discard saved di
    pop  di
    pop  si
    pop  cx
    pop  bx
    pop  ax
    stc
    ret

; ============================================================
; END
; ============================================================
















































































