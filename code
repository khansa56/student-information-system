; ============================================================
; CODE
; ============================================================
start:
    mov  dx, welcome_msg
    call print_string
    call wait_key

; ------------------------------------------------------------------
main_loop:
    ; clear screen properly
    mov  ax, 0003h          ; set video mode 3 (text 80x25) - clears screen
    int  10h

    mov  dx, main_menu
    call print_string
    call get_menu_digit     ; AL = '1'..'8'

    cmp  al, '8'
    jne  ml_not8
    jmp  exit_program
ml_not8:
    cmp  al, '1'
    jb   ml_invalid
    cmp  al, '7'
    ja   ml_invalid

    sub  al, '1'
    xor  ah, ah
    shl  ax, 1
    mov  si, ax
    jmp  [menu_jumps + si]

ml_invalid:
    mov  dx, invalid_choice
    call print_string
    call wait_key
    jmp  main_loop

menu_jumps  dw admission_module
            dw status_module
            dw fee_module
            dw attendance_module
            dw results_module
            dw health_module
            dw view_all_module

; ============================================================
; MODULE 1: ADMISSION
; ============================================================
admission_module:
    mov  dx, adm_header
    call print_string

    mov  al, [student_count]
    cmp  al, MAX_STUDENTS
    jb   adm_not_full
    jmp  adm_full_error
adm_not_full:

    ; DI -> new record
    xor  ah, ah
    mov  bx, RECORD_SIZE
    mul  bx
    mov  di, student_records
    add  di, ax

    ; --- ID ---
    mov  dx, adm_prompt_id
    call print_string
    call read_string
    call check_duplicate_id
    jnc  adm_no_dup
    jmp  adm_dup_error
adm_no_dup:
    push di
    mov  si, input_buffer + 2
    mov  cx, 5
    call copy_field
    pop  di

    ; --- Name ---
    mov  dx, adm_prompt_name
    call print_string
    call read_string
    push di
    add  di, 5
    mov  si, input_buffer + 2
    mov  cx, 21
    call copy_field
    pop  di

    ; --- Age ---
    mov  dx, adm_prompt_age
    call print_string
    call read_number
    mov  [di + 26], ax

    ; --- Class ---
    mov  dx, adm_prompt_cls
    call print_string
    call read_string
    push di
    add  di, 28
    mov  si, input_buffer + 2
    mov  cx, 6
    call copy_field
    pop  di

    ; --- Total Fee ---
    mov  dx, adm_prompt_fee
    call print_string
    call read_number
    mov  [di + 34], ax

    ; --- Fee Paid ---
    mov  dx, adm_prompt_paid
    call print_string
    call read_number
    mov  [di + 36], ax

    ; --- Defaults ---
    mov  byte [di + 38], 1
    mov  byte [di + 39], 0
    mov  byte [di + 40], 0
    mov  byte [di + 41], 0
    mov  byte [di + 42], 0
    mov  byte [di + 43], 0
    mov  byte [di + 44], 0
    mov  byte [di + 45], 0
    mov  byte [di + 46], 0

    inc  byte [student_count]
    mov  dx, adm_success
    call print_string
    jmp  return_to_main

adm_full_error:
    mov  dx, adm_full
    call print_string
    jmp  return_to_main

adm_dup_error:
    mov  dx, adm_dup_id
    call print_string
    jmp  return_to_main

; ============================================================
; MODULE 2: STATUS
; ============================================================
status_module:
    mov  dx, status_header
    call print_string
    mov  dx, status_prompt
    call print_string
    call read_string

    call find_student_by_id
    jnc  stat_found
    jmp  stat_notfound
stat_found:
    mov  dx, status_menu
    call print_string
    call get_14_digit
    sub  al, '0'
    cmp  al, 4
    jbe  stat_ok
    jmp  stat_invalid
stat_ok:
    mov  [di + 38], al
    mov  dx, status_success
    call print_string
    jmp  return_to_main

stat_invalid:
    mov  dx, invalid_choice
    call print_string
    jmp  return_to_main

stat_notfound:
    mov  dx, status_notfound
    call print_string
    jmp  return_to_main

; ============================================================
; MODULE 3: FEE
; ============================================================
fee_module:
    mov  dx, fee_header
    call print_string
    mov  dx, fee_prompt_id
    call print_string
    call read_string

    call find_student_by_id
    jnc  fee_found
    jmp  fee_notfound_lbl
fee_found:
    mov  dx, fee_display
    call print_string
    mov  ax, [di + 34]
    call print_number

    mov  dx, fee_paid_lbl
    call print_string
    mov  ax, [di + 36]
    call print_number

    mov  dx, fee_due_lbl
    call print_string
    mov  ax, [di + 34]
    sub  ax, [di + 36]
    call print_number

    mov  dx, newline
    call print_string

    mov  dx, fee_prompt_amt
    call print_string
    call read_number
    add  [di + 36], ax

    mov  dx, fee_success
    call print_string
    jmp  return_to_main

fee_notfound_lbl:
    mov  dx, fee_notfound
    call print_string
    jmp  return_to_main

; ============================================================
; MODULE 4: ATTENDANCE
; ============================================================
attendance_module:
    mov  dx, att_header
    call print_string
    mov  dx, att_prompt_id
    call print_string
    call read_string

    call find_student_by_id
    jnc  att_found
    jmp  att_notfound_lbl
att_found:
    mov  dx, att_prompt_days
    call print_string
    call read_number
    mov  [di + 39], al

    mov  dx, att_prompt_total
    call print_string
    call read_number
    mov  [di + 40], al

    ; show percentage
    mov  dx, att_percent_lbl
    call print_string
    mov  al, [di + 40]
    cmp  al, 0
    je   att_zero_total
    xor  ah, ah
    mov  bx, ax
    xor  ah, ah
    mov  al, [di + 39]
    xor  ah, ah
    mov  cx, 100
    mul  cx
    div  bx
    call print_number
    jmp  att_pct_done
att_zero_total:
    xor  ax, ax
    call print_number
att_pct_done:
    mov  dx, pct_sign
    call print_string
    mov  dx, att_success
    call print_string
    jmp  return_to_main

att_notfound_lbl:
    mov  dx, att_notfound
    call print_string
    jmp  return_to_main

; ============================================================
; MODULE 5: RESULTS
; ============================================================
results_module:
    mov  dx, res_header
    call print_string
    mov  dx, res_prompt_id
    call print_string
    call read_string

    call find_student_by_id
    jnc  res_found
    jmp  res_notfound_lbl
res_found:
    mov  dx, res_prompt_sub1
    call print_string
    call read_number
    mov  [di + 41], al

    mov  dx, res_prompt_sub2
    call print_string
    call read_number
    mov  [di + 42], al

    mov  dx, res_prompt_sub3
    call print_string
    call read_number
    mov  [di + 43], al

    mov  dx, res_prompt_sub4
    call print_string
    call read_number
    mov  [di + 44], al

    ; --- Total ---
    xor  ax, ax
    xor  bh, bh
    mov  bl, [di + 41]
    add  ax, bx
    mov  bl, [di + 42]
    add  ax, bx
    mov  bl, [di + 43]
    add  ax, bx
    mov  bl, [di + 44]
    add  ax, bx

    mov  dx, res_total_lbl
    call print_string
    push ax
    call print_number
    pop  ax

    ; --- Average ---
    xor  dx, dx
    mov  bx, 4
    div  bx
    push ax

    mov  dx, res_avg_lbl
    call print_string
    call print_number

    ; --- GPA (avg / 20) ---
    pop  ax
    push ax
    xor  dx, dx
    mov  bx, 20
    div  bx
    mov  dx, res_gpa_lbl
    call print_string
    call print_number

    ; --- Grade ---
    pop  ax
    mov  dx, res_grade_lbl
    call print_string
    cmp  al, 90
    jge  grd_a
    cmp  al, 80
    jge  grd_b
    cmp  al, 70
    jge  grd_c
    cmp  al, 60
    jge  grd_d
    mov  dl, 'F'
    jmp  grd_print
grd_a: mov dl, 'A'
    jmp  grd_print
grd_b: mov dl, 'B'
    jmp  grd_print
grd_c: mov dl, 'C'
    jmp  grd_print
grd_d: mov dl, 'D'
grd_print:
    mov  ah, 02h
    int  21h
    mov  dx, newline
    call print_string
    mov  dx, res_success
    call print_string
    jmp  return_to_main

res_notfound_lbl:
    mov  dx, res_notfound
    call print_string
    jmp  return_to_main

; ============================================================
; MODULE 6: HEALTH
; ============================================================
health_module:
    mov  dx, health_header
    call print_string
    mov  dx, health_prompt_id
    call print_string
    call read_string

    call find_student_by_id
    jnc  hlth_found
    jmp  hlth_notfound_lbl
hlth_found:
    mov  dx, health_prompt_fit
    call print_string
    call read_number
    mov  [di + 45], al

    mov  dx, health_prompt_dis
    call print_string
    call read_number
    mov  [di + 46], al

    cmp  al, 1
    jne  hlth_save
    mov  dx, health_prompt_desc
    call print_string
    call read_string
    push di
    add  di, 47
    mov  si, input_buffer + 2
    mov  cx, 20
    call copy_field
    pop  di

hlth_save:
    mov  dx, health_success
    call print_string
    jmp  return_to_main

hlth_notfound_lbl:
    mov  dx, health_notfound
    call print_string
    jmp  return_to_main

; ============================================================
; MODULE 7: VIEW ALL
; ============================================================
view_all_module:
    mov  dx, view_header
    call print_string

    mov  al, [student_count]
    cmp  al, 0
    jne  view_has_data
    jmp  view_empty_lbl
view_has_data:
    xor  ch, ch
    mov  cl, al
    mov  si, student_records

view_loop:
    push cx
    push si
    mov  di, si

    mov  dx, view_sep
    call print_string

    ; --- ID ---
    mov  dx, view_id_lbl
    call print_string
    mov  si, di
    mov  cx, 5
    call print_field_cx

    ; --- Name ---
    mov  dx, view_name_lbl
    call print_string
    lea  si, [di + 5]
    mov  cx, 21
    call print_field_cx

    ; --- Age ---
    mov  dx, view_age_lbl
    call print_string
    mov  ax, [di + 26]
    call print_number

    ; --- Class ---
    mov  dx, view_cls_lbl
    call print_string
    lea  si, [di + 28]
    mov  cx, 6
    call print_field_cx

    ; --- Status ---
    mov  dx, view_status_lbl
    call print_string
    mov  al, [di + 38]
    call print_status_label

    ; --- Fee ---
    mov  dx, fee_display
    call print_string
    mov  ax, [di + 34]
    call print_number

    mov  dx, fee_paid_lbl
    call print_string
    mov  ax, [di + 36]
    call print_number

    mov  dx, fee_due_lbl
    call print_string
    mov  ax, [di + 34]
    sub  ax, [di + 36]
    call print_number

    ; --- Attendance % ---
    mov  dx, att_percent_lbl
    call print_string
    mov  al, [di + 40]
    cmp  al, 0
    je   view_att_zero
    xor  ah, ah
    mov  bx, ax
    xor  ah, ah
    mov  al, [di + 39]
    xor  ah, ah
    mov  cx, 100
    mul  cx
    div  bx
    call print_number
    jmp  view_att_done
view_att_zero:
    xor  ax, ax
    call print_number
view_att_done:
    mov  dx, pct_sign
    call print_string

    ; --- Fitness ---
    mov  dx, health_fit_lbl
    call print_string
    xor  ah, ah
    mov  al, [di + 45]
    call print_number

    ; --- Disability ---
    mov  dx, health_dis_lbl
    call print_string
    cmp  byte [di + 46], 1
    jne  view_no_dis
    mov  dx, yes_str
    call print_string
    jmp  view_dis_done
view_no_dis:
    mov  dx, no_str
    call print_string
view_dis_done:
    mov  dx, newline
    call print_string

    pop  si
    pop  cx
    add  si, RECORD_SIZE
    dec  cx
    jnz  view_loop

    jmp  return_to_main

view_empty_lbl:
    mov  dx, view_empty
    call print_string
    jmp  return_to_main

; ============================================================
; EXIT & RETURN
; ============================================================
exit_program:
    mov  ax, 4C00h
    int  21h

return_to_main:
    mov  dx, return_menu
    call print_string
    call wait_key
    jmp  main_loop

; ============================================================
; HELPER ROUTINES
; ============================================================

; print '$'-terminated string, DX = address
print_string:
    push ax
    mov  ah, 09h
    int  21h
    pop  ax
    ret

; -------------------------------------------------------
; print_field_cx: print up to CX printable chars from [SI]
; stops at NUL or '$', prints spaces as spaces
; -------------------------------------------------------
print_field_cx:
    push ax
    push bx
    push cx
    push si
pfc_lp:
    jcxz pfc_done
    lodsb
    cmp  al, 0
    je   pfc_done
    cmp  al, '$'
    je   pfc_done
    mov  dl, al
    mov  ah, 02h
    int  21h
    dec  cx
    jmp  pfc_lp
pfc_done:
    pop  si
    pop  cx
    pop  bx
    pop  ax
    ret

; print AX as unsigned decimal (no leading zeros)
print_number:
    push ax
    push bx
    push cx
    push dx
    push si

    mov  si, temp_str
    add  si, 4
    mov  byte [si+1], '$'
    mov  cx, 5
    mov  bx, 10
pn_cvt:
    xor  dx, dx
    div  bx
    add  dl, '0'
    mov  [si], dl
    dec  si
    loop pn_cvt

    inc  si
pn_skip:
    cmp  byte [si], '0'
    jne  pn_print
    cmp  byte [si+1], '$'
    je   pn_print
    inc  si
    jmp  pn_skip
pn_print:
    mov  dx, si
    mov  ah, 09h
    int  21h

    pop  si
    pop  dx
    pop  cx
    pop  bx
    pop  ax
    ret

; print status label for AL (1..4)
print_status_label:
    push ax
    push bx
    push cx
    push si

    cmp  al, 1
    jb   psl_unknown
    cmp  al, 4
    ja   psl_unknown
    dec  al
    xor  ah, ah
    mov  bl, 12
    mul  bl
    mov  si, status_labels
    add  si, ax
    mov  cx, 12
psl_lp:
    lodsb
    cmp  al, ' '
    je   psl_nxt
    mov  dl, al
    mov  ah, 02h
    int  21h
psl_nxt:
    loop psl_lp
    jmp  psl_done
psl_unknown:
    mov  dx, newline
    call print_string
psl_done:
    pop  si
    pop  cx
    pop  bx
    pop  ax
    ret

; read buffered string into input_buffer
read_string:
    push ax
    push dx
    push si
    mov  byte [input_buffer],   23
    mov  byte [input_buffer+1],  0
    mov  dx, input_buffer
    mov  ah, 0Ah
    int  21h
    xor  ah, ah
    mov  al, [input_buffer+1]
    mov  si, input_buffer + 2
    add  si, ax
    mov  byte [si],   0
    mov  byte [si+1], '$'
    pop  si
    pop  dx
    pop  ax
    ret

; read decimal number, return in AX
read_number:
    push bx
    push cx
    push si
    call read_string
    mov  si, input_buffer + 2
    xor  ax, ax
    xor  ch, ch
    mov  cl, [input_buffer+1]
    jcxz rn_done
rn_lp:
    xor  bh, bh
    mov  bl, [si]
    inc  si
    sub  bl, '0'
    cmp  bl, 9
    ja   rn_done
    push bx
    mov  bx, 10
    mul  bx
    pop  bx
    add  ax, bx
    loop rn_lp
rn_done:
    pop  si
    pop  cx
    pop  bx
    ret

; wait for key '1'..'8', echo it, return in AL
get_menu_digit:
    push bx
    push cx
    push dx
gmd_lp:
    mov  ah, 01h
    int  21h
    cmp  al, 0Dh
    je   gmd_lp
    cmp  al, '1'
    jb   gmd_lp
    cmp  al, '8'
    ja   gmd_lp
    push ax
    mov  dl, al
    mov  ah, 02h
    int  21h
    pop  ax
    pop  dx
    pop  cx
    pop  bx
    ret

; wait for key '1'..'4', echo it, return in AL
get_14_digit:
    push bx
    push cx
    push dx
g14_lp:
    mov  ah, 01h
    int  21h
    cmp  al, 0Dh
    je   g14_lp
    cmp  al, '1'
    jb   g14_lp
    cmp  al, '4'
    ja   g14_lp
    push ax
    mov  dl, al
    mov  ah, 02h
    int  21h
    pop  ax
    pop  dx
    pop  cx
    pop  bx
    ret

; wait for any key (BIOS)
wait_key:
    push ax
    mov  ah, 00h
    int  16h
    pop  ax
    ret

; copy up to CX bytes from [SI] to [DI], space-pad remainder
copy_field:
    push ax
cf_copy:
    jcxz cf_done
    lodsb
    cmp  al, 0Dh
    je   cf_pad
    cmp  al, 0
    je   cf_pad
    cmp  al, '$'
    je   cf_pad
    stosb
    dec  cx
    jmp  cf_copy
cf_pad:
    mov  al, ' '
    rep  stosb
cf_done:
    pop  ax
    ret

; find student by ID in input_buffer+2
; CF=0 + DI=record base if found, CF=1 if not found
find_student_by_id:
    push ax
    push bx
    push cx
    push si

    mov  al, [student_count]
    cmp  al, 0
    je   fsid_not_found
    xor  ah, ah
    mov  bx, ax
    mov  di, student_records

fsid_loop:
    push di
    mov  si, input_buffer + 2
    mov  cx, 4
fsid_cmp:
    mov  al, [si]
    cmp  al, 0
    je   fsid_end_inp
    cmp  al, '$'
    je   fsid_end_inp
    cmp  al, [di]
    jne  fsid_no_match
    inc  si
    inc  di
    loop fsid_cmp
    mov  al, [di]
    cmp  al, ' '
    je   fsid_found_pop
    cmp  al, 0
    je   fsid_found_pop
    jmp  fsid_no_match
fsid_end_inp:
    mov  al, [di]
    cmp  al, ' '
    je   fsid_found_pop
    cmp  al, 0
    je   fsid_found_pop
fsid_no_match:
    pop  di
    add  di, RECORD_SIZE
    dec  bx
    jnz  fsid_loop

fsid_not_found:
    pop  si
    pop  cx
    pop  bx
    pop  ax
    stc
    ret

fsid_found_pop:
    pop  di
    pop  si
    pop  cx
    pop  bx
    pop  ax
    clc
    ret

; check duplicate ID; CF=1 if duplicate exists
check_duplicate_id:
    push ax
    push bx
    push cx
    push si
    push di

    mov  al, [student_count]
    cmp  al, 0
    je   cdup_no
    xor  ah, ah
    mov  bx, ax
    mov  di, student_records

cdup_loop:
    push di
    mov  si, input_buffer + 2
    mov  cx, 4
cdup_cmp:
    mov  al, [si]
    cmp  al, 0
    je   cdup_end_inp
    cmp  al, '$'
    je   cdup_end_inp
    cmp  al, [di]
    jne  cdup_no_match
    inc  si
    inc  di
    loop cdup_cmp
    mov  al, [di]
    cmp  al, ' '
    je   cdup_found
    cmp  al, 0
    je   cdup_found
    jmp  cdup_no_match
cdup_end_inp:
    mov  al, [di]
    cmp  al, ' '
    je   cdup_found
    cmp  al, 0
    je   cdup_found
cdup_no_match:
    pop  di
    add  di, RECORD_SIZE
    dec  bx
    jnz  cdup_loop

cdup_no:
    pop  di
    pop  si
    pop  cx
    pop  bx
    pop  ax
    clc
    ret

cdup_found:
    pop  di
    pop  di
    pop  si
    pop  cx
    pop  bx
    pop  ax
    stc
    ret

